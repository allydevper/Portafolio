<!-- RUTA DE VUELO (el trazo se calcula con JS según las secciones) -->
<svg id="flightTrail" aria-hidden="true">
    <defs>
        <mask id="routeMask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
            <path id="routeMaskPath" fill="none" stroke="#fff" stroke-width="26" stroke-linecap="round"/>
        </mask>
    </defs>
    <path id="routeFuture" fill="none" stroke="#2B6CB0" stroke-opacity=".22" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round"/>
    <g mask="url(#routeMask)">
        <path id="routeWash" fill="none" stroke="#7CC4E8" stroke-opacity=".22" stroke-width="16" stroke-linecap="round"/>
        <path id="routeDone" fill="none" stroke="#2B6CB0" stroke-opacity=".65" stroke-width="2.5" stroke-dasharray="10 9" stroke-linecap="round"/>
    </g>
</svg>

<!-- AVIÓN 3D (Three.js) -->
<canvas id="planeCanvas" aria-hidden="true"></canvas>
<!-- NUBES 3D DE FONDO (Three.js) -->
<canvas id="cloudCanvas" aria-hidden="true"></canvas>
